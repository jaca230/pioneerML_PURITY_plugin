{
  "training": {
    "hpo": {
      "architecture": {
        "type": "purity",
        "config": {
          "node_dim": 10,
          "edge_dim": 11,
          "graph_dim": 0,
          "hidden": 150,
          "heads": 5,
          "layers": 3,
          "dropout": 0.05
        }
      },
      "module": {
        "type": "purity_multilevel",
        "config": {
          "loss": {
            "type": "purity_unified",
            "config": {
              "w_atar_slice_multi": 0.1,
              "w_node_pdg": 0.5,
              "w_atar_edge": 0.25,
              "w_node_trigger": 0.0,
              "w_slice_pdg": 1.0,
              "w_atar_trigger_slice": 0.0,
              "w_pion_kinematics": 0.0,
              "w_endpoints": 0.1,
              "w_positron_angle": 0.0,
              "w_lyso_condensation": 0.25,
              "w_positron_energy": 0.0,
              "w_event_builder": 0.0
            }
          },
          "lr": 0.0001,
          "weight_decay": 0.0,
          "scheduler_step_size": null,
          "scheduler_gamma": 0.5,
          "optimizer_param_groups": [
            {
              "patterns": [
                "^model\\.impl\\.(sigma_t_atar_ns|sigma_t_lyso_floor_ns|sigma_t_lyso_scale_ns|angle_sigma_floor|angle_sigma_scale|direction_bias_temperature|temporal_bias_sigma)$"
              ],
              "lr_scale": 10.0,
              "weight_decay": 0.0
            },
            {
              "patterns": [
                "^model\\.impl\\.(slim_event_transformer|lyso_event_proj|atar_event_down|event_head|event_head_proj|event_modality_emb|event_slice_emb)(\\.|$)"
              ],
              "lr_scale": 5.0
            },
            {
              "patterns": [
                "^model\\."
              ],
              "lr_scale": 1.0,
              "weight_decay": 1e-08
            }
          ]
        }
      },
      "trainer": {
        "type": "lightning_module",
        "config": {
          "trainer_kwargs": {
            "enable_progress_bar": true,
            "max_epochs": 10,
            "gradient_clip_val": 1.0
          },
          "early_stopping": {
            "enabled": false,
            "type": "relative",
            "config": {
              "monitor": "val_loss",
              "mode": "min",
              "patience": 5,
              "min_delta": 0.05,
              "strict": true,
              "check_finite": true,
              "verbose": false
            }
          }
        }
      },
      "loader_manager": {
        "config": {
          "input_sources_spec": {
            "main_sources": [],
            "optional_sources_by_name": {},
